# Apache configuration for the static SPA build (dist/).
# Vite copies public/ verbatim, so this file ships with the build.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. The microphone is only available on a secure origin, so
  # without this the breath engine cannot start at all.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Client-side routing: anything that is not a real file or directory is
  # served index.html, so /map or /play/:gameId/:levelId survive a refresh.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The games need the microphone; everything else stays denied.
  Header always set Permissions-Policy "microphone=(self)"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Only /assets/ is content-hashed by Vite, so only it can be cached forever.
  # Files served from the root (favicon.svg, icons.svg) keep their name across
  # deploys and must stay revalidated.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # index.html points at the hashed assets — it must never be cached, or a
  # deploy leaves the browser on the previous build.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
